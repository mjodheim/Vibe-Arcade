{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/hivebound",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hivebound/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/stack-panic",
      "destination": "/stack-panic/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/stack-panic/",
      "destination": "/games/stack-panic/public/index.html"
    },
    {
      "source": "/stack-panic/:path*",
      "destination": "/games/stack-panic/public/:path*"
    }
  ]
}
