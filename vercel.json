{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/hivebound",
      "destination": "/hivebound/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/hivebound/",
      "destination": "/games/hivebound/public/index.html"
    },
    {
      "source": "/hivebound/:path*",
      "destination": "/games/hivebound/public/:path*"
    }
  ]
}
